NODE_ENV=development
SERVICE_NAME=rating-comment-service
SERVICE_VERSION=0.1.0
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

MONGODB_URI=mongodb://rating_user:rating_password@localhost:27027/ratingdb?authSource=admin
MONGODB_DB_NAME=ratingdb

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rating-comment-service
KAFKA_GROUP_ID=rating-comment-service-local
KAFKA_ENABLED=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rating-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_ENABLED=false
MEDIA_SIGNED_URL_TTL_SECONDS=600

REVIEW_MEDIA_MAX_COUNT=6
REVIEW_IMAGE_MAX_SIZE_BYTES=10485760
REVIEW_EDIT_WINDOW_DAYS=30
